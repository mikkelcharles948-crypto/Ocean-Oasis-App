{
  "expo": {
    "name": "Ocean Oasis Guest Experience",
    "slug": "ocean-oasis-dm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B3B45"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oceanoasisdominica.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ocean Oasis uses Face ID to sign you back in securely without re-entering your password."
      }
    },
    "android": {
      "package": "com.oceanoasisdominica.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {},
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#0B3B45"
        }
      ],
      "@sentry/react-native",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "5d08baf9-aab3-49fe-84d6-90dbdbfd78fb"
      }
    },
    "owner": "mcharles767s-team"
  }
}
