{
  "expo": {
    "name": "Ocean Oasis Guest Experience",
    "slug": "ocean-oasis-dm",
    "scheme": "oceanoasis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-square.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oceanoasisdominica.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ocean Oasis uses Face ID to sign you back in securely without re-entering your password."
      }
    },
    "android": {
      "package": "com.oceanoasisdominica.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-square.png",
        "backgroundColor": "#0B3B45"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {},
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#0B3B45"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "mcharles767s-team",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ocean Oasis uses your location to show your position on the map relative to the hotel, beaches, trails, and dining."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-square.png",
          "imageWidth": 140,
          "backgroundColor": "#0B3B45"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5d08baf9-aab3-49fe-84d6-90dbdbfd78fb"
      }
    },
    "owner": "mcharles767s-team"
  }
}
